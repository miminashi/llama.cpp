printf "  rdma-buf  <ptr>     - buffer context fields\n"
printf "  rdma-ctx  <ptr>     - backend context + conn\n"
printf "  rdma-wc   <ptr>     - work completion entry\n"
printf "  rdma-mr   <ptr>     - memory region info\n"
printf "  rdma-cmd-name <id>  - command ID to name\n"
printf "  rdma-threads        - thread list + hints\n"
printf "\n"
